---
import Header from "../components/Header.astro";
import Layout from "../layouts/Layout.astro";
import TimeLineContainer from "../components/TimeLineContainer.astro";
import TimeLineItem from "../components/TimeLineItem.astro";
import { data } from "../mock/data.ts";
import TimeLineGroup from "../components/TimeLineGroup.astro";
---

<Layout>
    <div class="grid grid-rows-[auto_1fr] w-screen h-screen">
        <Header>Historia de la lógica</Header>
        <TimeLineContainer>
            {
                data.map((group) => (
                    <TimeLineGroup
                        time={group.time}
                        color={group.color}
                        isFirst={group.id === 1}
                        isLast={group.id === 5}
                    >
                        {group.acts.map((item) => (
                            <TimeLineItem
                                title={item.title}
                                description={item.description}
                                autors={item.autors}
                                autorAvatars={item.autorAvatars}
                                year={item.year}
                                onTop={item.id % 2 === 1}
                                color={group.color}
                                img={item.img}
                            />
                        ))}
                    </TimeLineGroup>
                ))
            }
        </TimeLineContainer>
    </div>
</Layout>
