---
/**
 * AuthorCard
 *
 * dark:  --color-card-foreground: #faf9f5   (on-dark)
 * light: --color-card-foreground: #252523   (body-strong)
 */

interface Props {
    authors?: string[];
    authorAvatars?: string[];
    title: string;
    description: string;
    img?: string;
}

const {
    authors = [],
    authorAvatars = [],
    title,
    description,
    img,
} = Astro.props;

const avatars = authorAvatars.slice(0, authors.length);
const fallbacks = authors.slice(avatars.length);
const hasAuthors = authors.length > 0;

const uid = `card-${Math.random().toString(36).slice(2, 8)}`;
---

<!-- ── Card ── -->
<article
    id={uid}
    class="author-card relative mt-6 max-w-6xl w-full rounded-xl border font-[StyreneB,Inter,sans-serif] cursor-pointer transition-shadow hover:shadow-lg card-reveal flex items-stretch"
    style="border-color: var(--color-card-border); background-color: var(--color-card-bg);"
    role="button"
    tabindex="0"
    aria-haspopup="dialog"
    aria-controls={`${uid}-dialog`}
>
    <!-- ── Left: content ── -->
    <div class="flex-1 p-8 pt-7 relative">
        {
            hasAuthors && (
                <div class="absolute -top-[22px] left-8 flex items-center avatars-reveal">
                    {avatars.map((src, i) => (
                        <div
                            class="h-11 w-11 shrink-0 -mr-2.5 overflow-hidden rounded-full border-[2.5px]"
                            style={`z-index: ${avatars.length - i}; border-color: var(--color-avatar-ring)`}
                        >
                            <img
                                src={src}
                                alt={authors[i] ?? ""}
                                class="h-full w-full object-cover"
                                width="44"
                                height="44"
                            />
                        </div>
                    ))}
                    {fallbacks.map((name, i) => (
                        <div
                            class="h-11 w-11 shrink-0 -mr-2.5 flex items-center justify-center rounded-full border-[2.5px] text-base font-medium"
                            style={`z-index: ${fallbacks.length - i}; border-color: var(--color-avatar-ring); background-color: var(--color-avatar-fallback-bg); color: var(--color-avatar-fallback-text);`}
                            aria-hidden="true"
                        >
                            {name.charAt(0).toUpperCase()}
                        </div>
                    ))}
                </div>
            )
        }

        <div class="pt-7">
            <h2
                class="mb-2 font-['Copernicus','Tiempos_Headline',Georgia,serif] text-[28px] font-normal leading-[1.2] tracking-[-0.3px] title-reveal"
                style="color: var(--color-card-title)"
            >
                {title}
            </h2>
            {
                hasAuthors && (
                    <p
                        class="mb-4 text-[12px] font-medium uppercase leading-[1.4] tracking-[1.5px] meta-reveal"
                        style="color: var(--color-card-authors)"
                    >
                        {authors.join(" · ")}
                    </p>
                )
            }
            <p
                class="text-base font-normal leading-[1.55] desc-reveal"
                style="color: var(--color-card-description)"
            >
                {description}
            </p>
        </div>
    </div>

    <!-- ── Right: image 1:1 ── -->
    {
        img && (
            <div class="shrink-0 w-[140px] sm:w-[180px] rounded-r-xl overflow-hidden">
                <img
                    src={img}
                    alt=""
                    aria-hidden="true"
                    class="h-full w-full object-cover"
                />
            </div>
        )
    }
</article>

<!-- ── Dialog / Modal ── -->
<dialog
    id={`${uid}-dialog`}
    class="author-dialog backdrop:bg-black/50 backdrop:backdrop-blur-sm rounded-2xl border p-0 w-full max-w-3xl shadow-2xl"
    style="border-color: var(--color-card-border); background-color: var(--color-card-bg);"
    aria-labelledby={`${uid}-dialog-title`}
>
    <div class="flex min-h-[420px]">
        <!-- ── Left: content ── -->
        <div class="flex flex-col justify-between gap-6 p-8 flex-1">
            <!-- Close button -->
            <div class="flex justify-end">
                <button
                    class="dialog-close h-8 w-8 flex items-center justify-center rounded-full border text-lg leading-none transition-colors"
                    style="border-color: var(--color-card-border); color: var(--color-card-description);"
                    aria-label="Cerrar"
                >
                    ×
                </button>
            </div>

            <div class="flex-1 flex flex-col justify-center gap-4">
                <!-- Avatars -->
                {
                    hasAuthors && (
                        <div class="flex items-center">
                            {avatars.map((src, i) => (
                                <div
                                    class="h-11 w-11 shrink-0 -mr-2.5 overflow-hidden rounded-full border-[2.5px]"
                                    style={`z-index: ${avatars.length - i}; border-color: var(--color-avatar-ring)`}
                                >
                                    <img
                                        src={src}
                                        alt={authors[i] ?? ""}
                                        class="h-full w-full object-cover"
                                        width="44"
                                        height="44"
                                    />
                                </div>
                            ))}
                            {fallbacks.map((name, i) => (
                                <div
                                    class="h-11 w-11 shrink-0 -mr-2.5 flex items-center justify-center rounded-full border-[2.5px] text-base font-medium"
                                    style={`z-index: ${fallbacks.length - i}; border-color: var(--color-avatar-ring); background-color: var(--color-avatar-fallback-bg); color: var(--color-avatar-fallback-text);`}
                                    aria-hidden="true"
                                >
                                    {name.charAt(0).toUpperCase()}
                                </div>
                            ))}
                        </div>
                    )
                }

                <!-- Title -->
                <h2
                    id={`${uid}-dialog-title`}
                    class="font-['Copernicus','Tiempos_Headline',Georgia,serif] text-[36px] font-normal leading-[1.15] tracking-[-0.5px]"
                    style="color: var(--color-card-title)"
                >
                    {title}
                </h2>

                <!-- Authors -->
                {
                    hasAuthors && (
                        <p
                            class="text-[12px] font-medium uppercase leading-[1.4] tracking-[1.5px]"
                            style="color: var(--color-card-authors)"
                        >
                            {authors.join(" · ")}
                        </p>
                    )
                }

                <!-- Description -->
                <p
                    class="text-base font-normal leading-[1.55]"
                    style="color: var(--color-card-description)"
                >
                    {description}
                </p>
            </div>
        </div>

        <!-- ── Right: image 3:4 ── -->
        {
            img && (
                <div class="hidden sm:block w-[360px] shrink-0 overflow-hidden rounded-r-2xl">
                    <div class="relative h-full w-full">
                        <img
                            src={img}
                            alt=""
                            aria-hidden="true"
                            class="absolute inset-0 h-full w-full object-cover"
                        />
                    </div>
                </div>
            )
        }
    </div>
</dialog>

<style>
    /* ── Viewport reveal — initial hidden state ── */
    .card-reveal {
        opacity: 0;
        transform: translateY(24px);
        /* No transition here; added by JS once observed to avoid FOUC */
    }

    .card-reveal.is-visible {
        opacity: 1;
        transform: translateY(0);
        transition:
            opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1),
            transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }

    /* Child elements stagger — start hidden */
    .avatars-reveal,
    .title-reveal,
    .meta-reveal,
    .desc-reveal {
        opacity: 0;
        transform: translateY(10px);
    }

    /* When card is visible, animate children with staggered delays */
    .card-reveal.is-visible .avatars-reveal {
        opacity: 1;
        transform: translateY(0);
        transition:
            opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1) 0.15s,
            transform 0.4s cubic-bezier(0.16, 1, 0.3, 1) 0.15s;
    }

    .card-reveal.is-visible .title-reveal {
        opacity: 1;
        transform: translateY(0);
        transition:
            opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1) 0.22s,
            transform 0.4s cubic-bezier(0.16, 1, 0.3, 1) 0.22s;
    }

    .card-reveal.is-visible .meta-reveal {
        opacity: 1;
        transform: translateY(0);
        transition:
            opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1) 0.3s,
            transform 0.4s cubic-bezier(0.16, 1, 0.3, 1) 0.3s;
    }

    .card-reveal.is-visible .desc-reveal {
        opacity: 1;
        transform: translateY(0);
        transition:
            opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1) 0.38s,
            transform 0.4s cubic-bezier(0.16, 1, 0.3, 1) 0.38s;
    }

    /* Respect reduced-motion preference */
    @media (prefers-reduced-motion: reduce) {
        .card-reveal,
        .avatars-reveal,
        .title-reveal,
        .meta-reveal,
        .desc-reveal {
            opacity: 1 !important;
            transform: none !important;
            transition: none !important;
        }
    }

    /* ── Native <dialog> reset — center in viewport ── */
    .author-dialog {
        margin: auto;
    }

    /* Animate open */
    .author-dialog[open] {
        animation: dialog-in 0.18s ease-out both;
    }

    @keyframes dialog-in {
        from {
            opacity: 0;
            transform: translateY(8px) scale(0.98);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }
</style>

<script define:vars={{ uid }}>
    const card = document.getElementById(uid);
    const dialog = document.getElementById(`${uid}-dialog`);
    const closeBtn = dialog.querySelector(".dialog-close");

    // ── Viewport reveal via IntersectionObserver ──
    if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
            ([entry]) => {
                if (entry.isIntersecting) {
                    card.classList.add("is-visible");
                    observer.disconnect(); // fire once
                }
            },
            { threshold: 0.12 }, // trigger when 12% of the card is visible
        );
        observer.observe(card);
    } else {
        // Fallback: just show immediately
        card.classList.add("is-visible");
    }

    // ── Dialog open ──
    function openDialog() {
        dialog.showModal();
    }
    card.addEventListener("click", openDialog);
    card.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            openDialog();
        }
    });

    // Close via button
    closeBtn.addEventListener("click", () => dialog.close());

    // Close on backdrop click
    dialog.addEventListener("click", (e) => {
        const rect = dialog.getBoundingClientRect();
        const outsideClick =
            e.clientX < rect.left ||
            e.clientX > rect.right ||
            e.clientY < rect.top ||
            e.clientY > rect.bottom;
        if (outsideClick) dialog.close();
    });
</script>
