---
import Card from "./Card.astro";

interface Props {
    year: string;
    autors?: string[];
    autorAvatars?: string[];
    title: string;
    description: string;
    color: string;
    onTop: boolean;
    img?: string;
}
const { year, onTop, color } = Astro.props as Props;
---

<div class="relative grid grid-rows-2 overflow-hidden">
    <div class="flex w-5xl items-end border-b border-text-body p-6">
        {
            onTop ? (
                <Card
                    title={Astro.props.title}
                    authors={Astro.props.autors}
                    authorAvatars={Astro.props.autorAvatars}
                    description={Astro.props.description}
                    img={Astro.props.img}
                />
            ) : null
        }
    </div>
    <div class="flex w-5xl items-start border-t border-text-body p-6">
        {
            onTop ? null : (
                <Card
                    title={Astro.props.title}
                    authors={Astro.props.autors}
                    authorAvatars={Astro.props.autorAvatars}
                    description={Astro.props.description}
                    img={Astro.props.img}
                />
            )
        }
    </div>
    <div
        class="absolute top-1/2 left-1/2 transform -translate-1/2 py-1 px-3 text-text-header font-bold rounded-xl"
        style={{ backgroundColor: color }}
    >
        {year}
    </div>
</div>
