---
interface Props {
    time: string;
    color: string;
    nextColor?: string;
    isFirst?: boolean;
    isLast?: boolean;
}
const { time, color, nextColor, isFirst, isLast } = Astro.props as Props;
---

<div class="grid grid-rows-[auto_1fr]">
    <div
        class="relative flex justify-start items-center w-full h-12 py-2 px-4 text-text-header font-bold text-xl"
        style={{
            background: isLast
                ? `linear-gradient(to right, ${color} 100%);`
                : `linear-gradient(to right, ${color} 90%, ${nextColor} 100%);`,
            borderTopLeftRadius: isFirst ? "20px" : undefined,
            borderBottomLeftRadius: isFirst ? "20px" : undefined,
            borderTopRightRadius: isLast ? "20px" : undefined,
            borderBottomRightRadius: isLast ? "20px" : undefined,
        }}
    >
        <span class="sticky w-screen flex justify-center left-0 top-0">
            {time}
        </span>
    </div>
    <div class="flex flex-row">
        <slot />
    </div>
</div>
